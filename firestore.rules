rules_version = '2';
// 🕌 مدرسہ سافٹ ویئر (madrasa-md) — فائربیس کے حفاظتی اصول
// ہر مدرسے کا ڈیٹا صرف madrasas/<MD ID>/… میں؛ صرف اسی مدرسے کے جڑے موبائل (members) پڑھ / لکھ سکیں۔
// کسی دوسری ایپ (سبزی منڈی، AIO، آڑھت بک…) کا کوئی ڈیٹا یہاں نہیں — یہ پروجیکٹ صرف مدرسے کا۔
// والدین فائربیس کو سیدھا نہیں دیکھتے — ان کی رپورٹ سرور (worker) سے۔
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function mad(id) { return get(/databases/$(db)/documents/madrasas/$(id)).data; }
    function isOwner(id) { return signedIn() && mad(id).owner == request.auth.uid; }
    function isMember(id) { return signedIn() && exists(/databases/$(db)/documents/madrasas/$(id)/members/$(request.auth.uid)); }
    function me(id) { return get(/databases/$(db)/documents/madrasas/$(id)/members/$(request.auth.uid)).data; }
    // منتظم / مہتمم = پورا اختیار؛ خزانچی = فیس؛ استاد = صرف اپنی جماعتیں
    function isBoss(id) { return isOwner(id) || (isMember(id) && me(id).role in ['admin', 'moh']); }
    function canFee(id) { return isBoss(id) || (isMember(id) && me(id).role == 'fin'); }
    function myClass(id, g) { return isBoss(id) || (isMember(id) && me(id).role == 'teacher' && g in me(id).cls); }

    match /madrasas/{mdId} {
      // MD ID شکل: MD + ہندسے
      allow create: if signedIn() && mdId.matches('^MD[0-9]{3,8}$') && request.resource.data.owner == request.auth.uid;
      allow get: if isMember(mdId);
      allow update: if isOwner(mdId);
      allow list, delete: if false;

      // جڑے موبائل: مالک خود، یا جو جوڑنے کا کوڈ جانتا ہو (پہلے صرف استاد، کوئی جماعت نہیں — منتظم بعد میں دے)
      match /members/{uid} {
        allow read: if isMember(mdId);
        allow create: if signedIn() && uid == request.auth.uid && (
          mad(mdId).owner == request.auth.uid ||
          (request.resource.data.key == get(/databases/$(db)/documents/madrasas/$(mdId)/secret/join).data.key &&
           request.resource.data.role == 'teacher' && request.resource.data.cls.size() == 0));
        allow update, delete: if isBoss(mdId);
      }
      // جوڑنے کا کوڈ صرف مالک دیکھے / بدلے
      match /secret/{doc} {
        allow read, write: if isOwner(mdId);
      }
      // ریکارڈ (طلبہ، جماعتیں، سبق، حاضری، امتحان، تربیت، اعلان…) — g = جماعت
      match /records/{rid} {
        allow read: if isMember(mdId);
        allow create: if isMember(mdId) && myClass(mdId, request.resource.data.g);
        allow update: if isMember(mdId) && myClass(mdId, resource.data.g) && myClass(mdId, request.resource.data.g);
        allow delete: if false;   // حذف ہمیشہ نشان (d) سے
      }
      // فیس — صرف منتظم / مہتمم / خزانچی (استاد کو نظر بھی نہیں)
      match /fees/{rid} {
        allow read, create, update: if canFee(mdId);
        allow delete: if false;
      }
    }
    // باقی سب بند
    match /{path=**} { allow read, write: if false; }
  }
}
